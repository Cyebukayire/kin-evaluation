# Everything this project uses from OUTSIDE the repo. Scripts read this file.
# To use a different layout, put your own values in configs/paths.local.env (not committed).
# Check that everything is in place:  bash scripts/check_paths.sh

SCRATCH=/local/scratch/$USER
DATA_ROOT=$SCRATCH/data
HF_HOME=$SCRATCH/hf_cache                      # model weights and datasets (Hugging Face cache)

# Algorithm 2: retrieval corpus
WIKI_DIR=Wikipedia_rw                          # Kinyarwanda Wikipedia (WikiExtractor JSON), in the repo
KINNEWS_TRAIN=$DATA_ROOT/kinnews/train.csv     # KINNEWS raw train split; copyright of publishers, not committed
CORPUS_DIR=$DATA_ROOT/corpus/wiki_kinnews      # built by scripts/rag/build_corpus.py

# KinyaColBERT (external code + released weights + its agricultural benchmark)
DEEPKIN_AGAI=$SCRATCH/code/ac-ai-models/DeepKIN-AgAI
KINYACOLBERT_CKPT=$DATA_ROOT/kinyacolbert/kinya_colbert_large_rw_ag_retrieval_finetuned_512D.pt
KINYACOLBERT_AG_DATA=$DATA_ROOT/kinyacolbert/kinya-ag-retrieval

# MorphoKIN (morphological analyzer; academic license)
MORPHOKIN_IMAGE=$SCRATCH/opt/morphokin.tar.gz          # MorphoKIN Docker image (downloaded); converted into MORPHOKIN_SIF
MORPHODATA_DIR=$SCRATCH/opt/MORPHODATA                 # MorphoKIN data package (unpacked MORPHODATA.tar.gz)
MORPHOKIN_LICENSE=$SCRATCH/secrets/morphokin_license.dat   # license file; never commit or print
MORPHOKIN_SIF=$SCRATCH/containers/morphokin.sif            # Apptainer image (Ubuntu 22.04)
KCB_WORK_DIR=$DATA_ROOT/kinyacolbert/wiki_kinnews_afrimmlu    # KinyaColBERT inputs/outputs: corpus + AfriMMLU queries
AFRIMMLU_DIR=$DATA_ROOT/afrimmlu                              # AfriMMLU in our loader's format (scripts/download_data.py)
